#!/bin/bash
# Commit guard for this repo. Enabled by `core.hooksPath` pointing here, because
# git only reads ONE hooks directory (see README → "Commit guard").
#
# Two jobs:
#   1. refuse a commit whose identity is not the repository's published identity
#      (a stray `git -c user.email=…`, an exported GIT_AUTHOR_EMAIL, or a global
#      config would otherwise put a personal address into public history forever)
#   2. refuse a commit whose staged content matches a secret pattern, or a
#      machine-specific pattern from the optional, gitignored `hooks/local-patterns`
#
# Re-enable after a fresh clone:
#   git config core.hooksPath "$PWD/hooks"
set -euo pipefail

# --- adjust to your own published identity ---------------------------------
want="17977913+tripathiamritansh@users.noreply.github.com"
# ---------------------------------------------------------------------------

have=$(git config user.email || true)
if [ "$have" != "$want" ]; then
    echo "pre-commit: refusing to commit — user.email is '${have:-<unset>}', expected '$want'" >&2
    echo "            fix: git config user.email '$want'" >&2
    exit 1
fi

for var in GIT_AUTHOR_EMAIL GIT_COMMITTER_EMAIL; do
    val="${!var:-}"
    if [ -n "$val" ] && [ "$val" != "$want" ]; then
        echo "pre-commit: refusing to commit — $var='$val'" >&2
        exit 1
    fi
done

# Credential shapes (provider-agnostic, safe to publish).
patterns='ghp_|github_pat_|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY'

# Machine-specific identifiers stay out of the repository, in an ignored file:
#   hooks/local-patterns   (one grep -E alternation per line is fine)
if [ -f hooks/local-patterns ]; then
    local_patterns=$(grep -v '^\s*#' hooks/local-patterns | grep -v '^\s*$' | paste -sd'|' - || true)
    [ -n "$local_patterns" ] && patterns="$patterns|$local_patterns"
fi

# The sanctioned identity is allowed to appear (it is in this file); strip it
# before matching so broad patterns like a surname do not false-positive on it.
# This file is excluded from the scan: it necessarily contains the credential
# patterns themselves, which would otherwise make it refuse its own commit.
added=$(git diff --cached --diff-filter=ACM -U0 -- . ':(exclude)hooks/pre-commit' \
    | grep -E '^\+' | sed "s|$want||g" || true)
if printf '%s' "$added" | grep -E -i -q "$patterns"; then
    echo "pre-commit: staged content matches a secret or machine-specific pattern:" >&2
    printf '%s\n' "$added" | grep -E -i -n "$patterns" >&2
    exit 1
fi
